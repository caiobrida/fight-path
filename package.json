{
  "name": "fight-path",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-release.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format:check": "prettier --check src scripts next.config.ts eslint.config.mjs package.json tsconfig.json compose.yaml vercel.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:up": "docker compose --env-file .env.local up -d db",
    "db:migrate:local": "node --env-file=.env.local scripts/migrate.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.30.0",
    "@clerk/localizations": "^4.25.0",
    "@clerk/nextjs": "^7.10.1",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
